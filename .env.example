# Postgres. Local dev uses embedded-postgres (npm run db:start) on port 5433.
# Docker users: `docker compose up -d` exposes the same port and credentials.
PGHOST=localhost
PGPORT=5433
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres

# Database the app uses, and a separate one for the test suite.
DB_NAME=roomly
TEST_DB_NAME=roomly_test

# Low-privilege role the API connects as. It is subject to Row-Level Security.
APP_DB_USER=roomly_app
APP_DB_PASSWORD=roomly_app_dev

# Privileged role for login / webhooks / workers (pre-tenant code paths). Allowed across
# tenants by explicit RLS policies (migration 007), not by a superuser attribute.
SYSTEM_DB_USER=roomly_system
SYSTEM_DB_PASSWORD=roomly_system_dev

API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Auth. Access tokens are short-lived JWTs; refresh tokens are opaque, rotated on every use.
# Generate a real secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_DAYS=7

# Stripe (test mode). Billing endpoints return 503 until STRIPE_SECRET_KEY is set.
#   Dashboard → Developers → API keys (use the sk_test_... key)
#   Create two recurring Products/Prices (Pro, Enterprise) and paste their price ids.
#   Webhook secret: run `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Google Calendar sync. The "Connect Google Calendar" button returns 503 until these are set.
#   Google Cloud Console → APIs & Services → enable "Google Calendar API"
#   → OAuth consent screen (External, add yourself as a test user)
#   → Credentials → OAuth client ID (Web application), authorized redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/google/callback

# 32-byte key (base64) that encrypts stored Google refresh tokens. Replace outside development:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=ZGV2LW9ubHktdG9rZW4ta2V5LWNoYW5nZS1tZS0zMmI=

# Per-IP limit for login/signup/refresh/invitation endpoints.
RATE_LIMIT_AUTH_PER_MINUTE=20

# Proxies in front of the API that append X-Forwarded-For (CloudFront → EC2 = 1).
TRUST_PROXY_HOPS=1
