# Postgres. `npm run db:start` runs a local one on port 5433.
# With Docker, `docker compose up -d` gives the same port and credentials.
PGHOST=localhost
PGPORT=5433
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=postgres
DB_NAME=roomly

# The role the API connects as. Row-level security applies to it.
APP_DB_USER=roomly_app
APP_DB_PASSWORD=roomly_app_dev

API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Login. Use a real secret outside development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITE_TTL_DAYS=7
# Login, signup and refresh attempts allowed per IP address per minute.
RATE_LIMIT_AUTH_PER_MINUTE=20

# Stripe (test mode). Upgrades are switched off until STRIPE_SECRET_KEY is set.
#   Create two monthly prices (Pro, Enterprise) and paste their ids below.
#   Webhook secret: stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
