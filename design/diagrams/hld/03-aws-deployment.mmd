flowchart TB
  classDef edge fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
  classDef svc fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
  classDef db fill:#dcfce7,stroke:#16a34a,color:#14532d
  classDef ext fill:#fef3c7,stroke:#d97706,color:#78350f
  classDef sec fill:#fce7f3,stroke:#db2777,color:#831843

  User["Users' browsers"]:::edge
  CF["Amazon CloudFront<br/>https://dxxxx.cloudfront.net<br/>free TLS, HTTP/2+3, WebSockets"]:::edge

  subgraph S3B["S3 bucket (private, encrypted)"]
    SITE["site/ — SPA build<br/>(Origin Access Control;<br/>CloudFront Function maps routes → index.html)"]:::edge
    DEP["deploy/ — compose file + host scripts"]:::sec
    BAK["backups/ — nightly pg_dump<br/>(expires after 7 days)"]:::db
  end

  subgraph REGION["ap-south-1 (Mumbai) — default VPC"]
    SG["Security group<br/>:80 from CloudFront prefix list ONLY<br/>no SSH port"]:::sec
    subgraph EC2["EC2 t4g.micro (Graviton, AL2023) + Elastic IP + 1 GB swap"]
      API["api container<br/>Express + Socket.io + worker<br/>80 → 4000"]:::svc
      MIG["migrate container<br/>(one-shot per deploy)"]:::svc
      PG[("postgres:17 container<br/>EBS gp3 20 GB volume")]:::db
      TMR["systemd timers<br/>02:00 backup · 02:30 demo reset"]:::svc
    end
  end

  SSM["SSM Parameter Store /roomly/*<br/>secrets generated on first deploy"]:::sec
  GH["GitHub Actions<br/>CI: tests + arm64 image → GHCR<br/>Deploy: OIDC role (no stored keys)"]:::sec
  GHCR["ghcr.io/gofuu/roomly-api:&lt;sha&gt;"]:::sec
  Stripe["Stripe"]:::ext
  Google["Google APIs"]:::ext

  User --> CF
  CF -- "/*" --> SITE
  CF -- "/api/*  /socket.io/*  (no caching)" --> SG --> API
  API --> PG
  MIG --> PG
  TMR --> PG
  TMR --> BAK
  API --> Stripe & Google
  Stripe -- "webhooks" --> CF

  GH -- "s3 sync" --> SITE
  GH -- "s3 sync" --> DEP
  GH -- "SSM Run Command → deploy.sh" --> EC2
  GH -- "push image" --> GHCR
  GHCR -. "docker pull" .-> EC2
  SSM -. "deploy.sh writes root-only .env" .-> EC2
  DEP -. "copied to /opt/roomly" .-> EC2
