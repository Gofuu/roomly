flowchart TB
  classDef s fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
  classDef ok fill:#dcfce7,stroke:#16a34a,color:#14532d
  classDef skip fill:#f1f5f9,stroke:#64748b,color:#334155

  T["AFTER INSERT OR UPDATE OF status, during, title, room_id ON bookings<br/>FOR EACH ROW → bookings_enqueue_calendar_sync()<br/>(runs as the caller's role, inside the caller's transaction)"]:::s
  OP{"TG_OP"}
  I{"NEW.status = confirmed?"}
  C{"OLD confirmed → NEW cancelled?"}
  M{"NEW confirmed AND (during, title, room_id)<br/>IS DISTINCT FROM OLD?"}
  UP["action = upsert"]:::s
  DEL["action = delete"]:::s
  NONE["no action"]:::skip
  G{"EXISTS google_connections<br/>WHERE user_id = NEW.user_id ?<br/>(RLS: same org)"}
  INS["INSERT calendar_sync_outbox<br/>(org_id, booking_id, user_id, action)"]:::ok

  T --> OP
  OP -- INSERT --> I
  I -- yes --> UP
  I -- no --> NONE
  OP -- UPDATE --> C
  C -- yes --> DEL
  C -- no --> M
  M -- yes --> UP
  M -- no --> NONE
  UP & DEL --> G
  G -- yes --> INS
  G -- no --> NONE

  N["Covers every write path, including member deactivation's bulk cancel.<br/>If the booking transaction rolls back (e.g. 23P01), the job disappears with it."]
  INS ~~~ N
